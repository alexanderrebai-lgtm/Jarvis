{
  "name": "@muscu/jarvis-desktop",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Jarvis pour Windows : voix, claquements de mains, caméras, gestes, contrôle du PC",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "dist": "node build.mjs && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.312",
    "@huggingface/transformers": "4.3.2",
    "electron-updater": "6.8.11",
    "exceljs": "4.4.0",
    "ffmpeg-static": "5.3.0",
    "mammoth": "1.13.0",
    "pdfjs-dist": "6.4.299",
    "playwright": "1.63.0",
    "systeminformation": "5.33.18",
    "tp-link-tapo-connect": "2.0.15"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@mediapipe/tasks-vision": "1.2.0",
    "@muscu/jarvis": "workspace:*",
    "@types/node": "22.19.1",
    "@types/three": "0.186.0",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "msedge-tts": "2.1.1",
    "three": "0.186.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "zod": "3.25.76"
  },
  "build": {
    "appId": "fr.alex.jarvis",
    "productName": "Jarvis",
    "copyright": "Alex",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "assets/**",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/@anthropic-ai/claude-agent-sdk*/**",
      "node_modules/ffmpeg-static/**",
      "node_modules/onnxruntime-node/**",
      "node_modules/@huggingface/transformers/**",
      "node_modules/playwright-core/**",
      "assets/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "Jarvis-${version}-installation.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Jarvis",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "alexanderrebai-lgtm",
        "repo": "Jarvis",
        "releaseType": "release"
      }
    ]
  }
}
