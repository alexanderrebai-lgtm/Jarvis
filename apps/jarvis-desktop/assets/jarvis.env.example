# Réglages de Jarvis. Ce fichier est privé : ne le partage jamais.
# Après une modification, quitte Jarvis (icône près de l'horloge) et relance-le.

OWNER_NAME=Alex
TZ=Europe/Paris
# Ta ville, pour la météo de l'accueil (Open-Meteo, gratuit)
JARVIS_VILLE=

# ---------- Cerveau ----------
# Sans clé : Jarvis utilise ton abonnement Claude, par la connexion de Claude Code sur ce PC
# (lance « claude » une fois dans un terminal et connecte-toi).
# Avec une clé (console.anthropic.com), il l'utilise à la place, facturée à l'usage.
ANTHROPIC_API_KEY=
# Laisser vide pour le modèle par défaut de ton compte
CLAUDE_MODEL=

# ---------- Voix ----------
# Voix féminines françaises : fr-FR-VivienneMultilingualNeural, fr-FR-DeniseNeural, fr-FR-EloiseNeural
JARVIS_VOICE=fr-FR-VivienneMultilingualNeural
JARVIS_VOICE_RATE=+5%
JARVIS_VOICE_PITCH=+0Hz
# Répondre à voix haute aussi quand tu écris (true ou false)
SPEAK_TYPED=true
# Secondes pendant lesquelles tu peux continuer sans redire « Jarvis »
CONVERSATION_SECONDS=20

# ---------- Oreilles (reconnaissance vocale sur le PC) ----------
# whisper-small (bon compromis), whisper-medium (plus précis, plus lent), whisper-base (rapide)
STT_MODEL=auto
# dml = carte graphique (DirectML), cpu = processeur
STT_DEVICE=dml

# ---------- Automatismes ----------
BRIEFING_TIME=07:30
EVENT_REMINDER_MINUTES=15

# ---------- Ingénieur de course (Le Mans Ultimate, F1) ----------
# minimal (meilleurs tours et alertes), normal, ou bavard (chaque tour, points réguliers)
INGENIEUR_BAVARDAGE=normal
# Port de télémétrie UDP réglé dans le jeu F1
F1_UDP_PORT=20777
# Numéro du bouton du volant pour parler à Jarvis (l'accueil te l'indique quand tu appuies pendant une séance)
BOUTON_VOLANT_PARLER=

# ---------- Maison : Tapo ----------
TAPO_EMAIL=
TAPO_PASSWORD=
# Facultatif : Lampe salon=192.168.1.20,Prise télé=192.168.1.21
TAPO_DEVICES=

# ---------- Caméras de surveillance Tapo (page Sécurité) ----------
# Dans l'appli Tapo : caméra → Paramètres → Paramètres avancés → Compte de la caméra
TAPO_CAMERA_COMPTE=
TAPO_CAMERA_MOT_DE_PASSE=
# Noms et adresses IP fixes : Entrée=192.168.1.30,Jardin=192.168.1.31
TAPO_CAMERAS=

# ---------- Autres objets : Home Assistant (facultatif) ----------
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=

# ---------- Google : Gmail + Agenda (facultatif, voir le guide) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ---------- Navigateur pour les réservations ----------
BROWSER_ENABLED=true
CHROMIUM_PATH=

# ---------- Téléphone (facultatif) ----------
# Connecteur pour l'app Claude du téléphone et raccourcis SMS, via un Cloudflare Tunnel vers le port ci-dessous
WEBHOOK_SECRET=
PORT=8787

# ---------- Réveil (planning + Spotify) ----------
# off pour désactiver le réveil
REVEIL=on
# Chemin du planning Excel ; ton nom tel qu'il y est écrit ; codes éventuels (M=08:00-15:00,S=14:00-21:00)
PLANNING_FICHIER=
PLANNING_NOM=
PLANNING_CODES=
# Minutes entre le réveil et le début du poste ; heure et jours sans planning ; jours de repos (aucun ou HH:MM)
REVEIL_AVANT_TRAVAIL=75
REVEIL_HEURE=07:45
REVEIL_JOURS=lun-ven
REVEIL_REPOS=aucun
# Lampes Tapo du lever de soleil ; musique après le message (continuer ou pause)
REVEIL_LUMIERES=chambre
REVEIL_MUSIQUE_APRES=continuer
# Ton appli sur developer.spotify.com (Redirect URI : http://127.0.0.1:8898/spotify) ; playlist de réveil (facultatif)
SPOTIFY_CLIENT_ID=
SPOTIFY_REVEIL=

# ---------- Verrou vocal ----------
VOIX_SEUIL=0.86
VOIX_INVITES_MAISON=false

# ---------- Surveillance complète ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SURVEILLANCE_LUMIERES=tout
SURVEILLANCE_DISSUASION=true

# ---------- Travail (pseudonymes) ----------
# Noms de l'équipe, séparés par des virgules (ou un par ligne dans Documents\Jarvis\travail\equipe.txt)
EQUIPE=
TRAVAIL_PSEUDONYMES=true

# ---------- Recherche ----------
OPENALEX_CLE=
SEMANTIC_SCHOLAR_CLE=

# ---------- IA locale (Ollama) ----------
OLLAMA_URL=http://127.0.0.1:11434
IA_LOCALE_MODELE=

# ---------- Sauvegardes et mises à jour ----------
SAUVEGARDE_COPIE=
MISE_A_JOUR_URL=
