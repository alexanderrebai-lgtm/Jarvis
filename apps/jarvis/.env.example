# Copie ce fichier en .env et remplis les valeurs (ne partage jamais .env).

# ---------- Obligatoire ----------
# Ton prénom, pour que Jarvis s'adresse à toi
OWNER_NAME=
TZ=Europe/Paris
# Secret du connecteur Claude et des raccourcis iPhone : une longue suite aléatoire.
# Par exemple le résultat de : openssl rand -hex 24
WEBHOOK_SECRET=
PORT=8787

# ---------- Google : Gmail + Agenda (facultatif, voir README) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ---------- Ampoules et prises Tapo (facultatif, voir README) ----------
# Ton compte de l'appli Tapo. Jarvis doit tourner sur le même Wi-Fi que les appareils.
TAPO_EMAIL=
TAPO_PASSWORD=
# Facultatif mais plus fiable : noms et adresses IP fixes, séparés par des virgules
# TAPO_DEVICES=Lampe salon=192.168.1.20,Prise télé=192.168.1.21
TAPO_DEVICES=

# ---------- Autres marques : Home Assistant (facultatif, voir README) ----------
# Adresse de ton Home Assistant, ex. http://homeassistant.local:8123 ou https://xxxx.ui.nabu.casa
HOME_ASSISTANT_URL=
# Profil Home Assistant → Sécurité → Jetons d'accès longue durée
HOME_ASSISTANT_TOKEN=

# ---------- Navigateur pour les réservations en ligne ----------
BROWSER_ENABLED=true
# Chemin de Chromium, seulement s'il n'a pas été installé par Playwright
CHROMIUM_PATH=

# ---------- Mode automatique (facultatif, facturé à l'usage) ----------
# Sans ces deux valeurs, Jarvis fonctionne en mode abonnement : tu lui parles
# depuis l'app Claude et c'est ton abonnement qui paie.
# Clé API Claude : https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# claude-sonnet-5-5 coûte environ deux fois moins cher
ANTHROPIC_MODEL=claude-opus-5-5
# Bot Telegram : crée-le avec @BotFather, colle le jeton ici
TELEGRAM_BOT_TOKEN=
# Laisse vide au premier lancement : le bot te donnera la valeur à mettre
TELEGRAM_CHAT_ID=
BRIEFING_TIME=07:30
GMAIL_POLL_MINUTES=5
EVENT_REMINDER_MINUTES=30

DATA_DIR=data
